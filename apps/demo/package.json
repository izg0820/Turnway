{
  "name": "@turnway/demo",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS browser demo of the turnway waiting room module",
  "main": "dist/main.js",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "start": "pnpm build && node dist/main.js",
    "start:console": "pnpm build && node dist/console.js",
    "record": "pnpm build && node scripts/record.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.2.6",
    "ioredis": "^5.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "turnway": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "gifenc": "^1.0.3",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.0"
  }
}
